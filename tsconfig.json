{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2022",
		"lib": ["es2022"],
		"types": ["node", "vscode", "mocha"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "out",
		"sourceMap": true,
		"strict": true,
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", ".vscode-test", "**/*.spec.ts", "src/extractor/fixtures.ts"]
}
