# Only `out/` (compiled JS + the vendored Air resolver wasm) and the real
# runtime `dependencies` (see package.json) need to ship in the .vsix.
# Everything else here is source, dev tooling, or test-only.

.vscode-test.mjs
.vscode/**
.github/**
.gitignore
eslint.config.mjs
tsconfig.json
vitest.config.mts
scripts/**
air-resolver/**
src/**
out/test/**
out/**/*.map
package-lock.json
*.vsix

# Source maps for bundled libraries aren't useful in an installed extension.
node_modules/**/*.map

