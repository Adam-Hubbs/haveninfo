{
	"name": "r-haven-info",
	"displayName": "Haven Info",
	"description": "R Haven Labeled information on hover",
	"version": "0.1.0",
	"publisher": "adam-hubbs",
	"repository": {
		"type": "git",
		"url": "https://github.com/Adam-Hubbs/haveninfo"
	},
	"engines": {
		"vscode": "^1.74.0",
		"positron": "^2025.6.x"
	},
	"categories": [
		"Data Science"
	],
	"activationEvents": [
		"onLanguage:r"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "haven-info.hello-world",
				"title": "Haven Info Hello World"
			},
			{
				"command": "haven-info.get-variables",
				"title": "Haven Info Get Variables"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20",
		"@types/sinon": "^17.0.4",
		"@types/vscode": "^1.100.0",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^9.13.0",
		"glob": "^11.0.0",
		"mocha": "^11.6.0",
		"sinon": "^20.0.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	},
	"dependencies": {
		"@posit-dev/positron": "^0.1.3"
	}
}
