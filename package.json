{
	"name": "r-haven-info",
	"displayName": "Haven Info",
	"description": "R Haven Labeled information on hover",
	"version": "0.1.1",
	"publisher": "adam-hubbs",
	"repository": {
		"type": "git",
		"url": "https://github.com/Adam-Hubbs/haveninfo"
	},
	"engines": {
		"vscode": "^1.104.0",
		"positron": "^2025.9.0"
	},
	"categories": [
		"Data Science"
	],
	"activationEvents": [
		"onLanguage:r"
	],
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.1",
		"@types/sinon": "^22.0.0",
		"@types/vscode": "^1.104.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"eslint": "^10.9.0",
		"glob": "^13.0.6",
		"mocha": "^11.8.0",
		"sinon": "^22.1.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0"
	},
	"dependencies": {
		"@posit-dev/positron": "^0.2.8"
	}
}
